+void ExtensionsToolbarAndroid::ToggleActionPinned(
+    const ToolbarActionsModel::ActionId& action_id) {
+  ToolbarActionsModel* model =
+      ToolbarActionsModel::Get(browser_->GetProfile());
+  if (model && !model->IsActionForcePinned(action_id)) {
+    model->SetActionVisibility(action_id, !model->IsActionPinned(action_id));
+  }
