subject: Add pure black theme for OLED panels

A switch in Settings > Appearance > Theme paints the browser true black instead of
Material dark grey, so OLED pixels are switched off rather than lit. Dark mode only,
and applied when an Activity is themed, so a snackbar offers to relaunch.
---
diff --git a/components/browser_ui/styles/android/java/res/values/themes.xml b/components/browser_ui/styles/android/java/res/values/themes.xml
--- a/components/browser_ui/styles/android/java/res/values/themes.xml
+++ b/components/browser_ui/styles/android/java/res/values/themes.xml
@@ -44,4 +44,24 @@
         <!-- Click event uses dark mode colors -->
         <item name="colorControlHighlight">@color/ripple_material_dark</item>
     </style>
+    <style name="ThemeOverlay.BrowserUI.PureBlack" parent="">
+        <item name="android:colorBackground">@android:color/black</item>
+        <item name="colorSurface">@android:color/black</item>
+        <item name="colorSurfaceDim">@android:color/black</item>
+        <item name="colorSurfaceContainerLowest">@android:color/black</item>
+        <item name="colorSurfaceContainerLow">@android:color/black</item>
+        <item name="colorSurfaceContainer">@android:color/black</item>
+        <item name="colorSurfaceContainerHigh">#121212</item>
+        <item name="colorSurfaceBright">#1A1A1A</item>
+        <item name="colorSurfaceContainerHighest">#1A1A1A</item>
+        <item name="elevationOverlayEnabled">false</item>
+        <item name="colorOnSurface">@android:color/white</item>
+        <item name="colorOnSurfaceVariant">#CCFFFFFF</item>
+        <item name="colorOnBackground">@android:color/white</item>
+        <item name="globalFilledButtonBgColor">?attr/colorPrimary</item>
+        <item name="globalFilledButtonTextColor">?attr/colorOnPrimary</item>
+        <item name="globalFilledTonalButtonBgColor">?attr/colorPrimaryContainer</item>
+        <item name="globalFilledTonalButtonTextColor">?attr/colorOnPrimaryContainer</item>
+        <item name="globalTextButtonTextColor">?attr/colorPrimary</item>
+    </style>
 </resources>
