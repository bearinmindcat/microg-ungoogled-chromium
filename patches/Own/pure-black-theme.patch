+    private static final int RESTART_SNACKBAR_DURATION_MS = 10000;
+
+    private void showRestartSnackbar() {
+        Activity activity = getActivity();
+        if (!(activity instanceof SnackbarManageable)) return;
+        SnackbarManager manager = ((SnackbarManageable) activity).getSnackbarManager();
+        manager.showSnackbar(
+                Snackbar.make(
+                                getString(R.string.restart_to_apply),
+                                new SnackbarManager.SnackbarController() {
+                                    @Override
+                                    public void onAction(@Nullable Object actionData) {
+                                        ApplicationLifetime.terminate(true);
+                                    }
+                                },
+                                Snackbar.TYPE_ACTION,
+                                Snackbar.UMA_UNKNOWN)
+                        .setAction(getString(R.string.relaunch), null)
+                        .setDuration(RESTART_SNACKBAR_DURATION_MS));
+    }
+
     @Override
     public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
         SettingsUtils.addPreferencesFromResource(this, R.xml.theme_preferences);
@@ -75,6 +103,21 @@
                     return true;
                 });
 
+        ChromeSwitchPreference pureBlack =
+                (ChromeSwitchPreference) findPreference("pure_black");
+        if (pureBlack != null) {
+            pureBlack.setChecked(
+                    sharedPreferencesManager.readBoolean(
+                            ChromePreferenceKeys.PURE_BLACK, true));
+            pureBlack.setOnPreferenceChangeListener(
+                    (preference, newValue) -> {
+                        sharedPreferencesManager.writeBoolean(
+                                ChromePreferenceKeys.PURE_BLACK, (boolean) newValue);
+                        showRestartSnackbar();
+                        return true;
+                    });
+        }
