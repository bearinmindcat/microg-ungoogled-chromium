 #if BUILDFLAG(IS_ANDROID)
+  if (!launched_activity_ &&
+      profile_->GetOriginalProfile()->GetPrefs()->GetBoolean(
+          kDevToolsOpenInNewTabPref)) {
+    if (!owned_main_web_contents_) {
+      tabs::TabInterface* devtools_tab =
+          tabs::TabInterface::MaybeGetFromContents(main_web_contents_);
+      if (devtools_tab && devtools_tab->GetBrowserWindowInterface()) {
+        if (TabListInterface* tab_list = TabListInterface::From(
+                devtools_tab->GetBrowserWindowInterface())) {
+          tab_list->ActivateTab(devtools_tab->GetHandle());
+        }
+      }
+      return;
+    }
+    content::WebContents* inspected = GetInspectedWebContents();
+    tabs::TabInterface* inspected_tab =
+        inspected ? tabs::TabInterface::MaybeGetFromContents(inspected)
+                  : nullptr;
+    TabListInterface* tab_list =
+        inspected_tab && inspected_tab->GetBrowserWindowInterface()
+            ? TabListInterface::From(inspected_tab->GetBrowserWindowInterface())
+            : nullptr;
+    if (tab_list) {
+      std::unique_ptr<content::WebContents> contents =
+          OwnedMainWebContents::TakeWebContents(
+              std::move(owned_main_web_contents_));
+      if (contents) {
+        tabs::TabInterface* devtools_tab = tab_list->InsertWebContentsAt(
+            tab_list->GetIndexOfTab(inspected_tab->GetHandle()) + 1,
+            std::move(contents), false, std::nullopt);
+        if (devtools_tab) {
+          tab_list->ActivateTab(devtools_tab->GetHandle());
+        }
+        OverrideAndSyncDevToolsRendererPrefs();
+      }
+      return;
+    }
+  }
   if (!owned_main_web_contents_ || launched_activity_) {
     return;
   }
