+
+    private static void setupKeepOpenCheckbox(PropertyModel model, View view) {
+        if (!model.containsKey(AppMenuItemProperties.KEEP_MENU_OPEN)
+                || !model.get(AppMenuItemProperties.KEEP_MENU_OPEN)) {
+            return;
+        }
+        AppMenuClickHandler clickHandler = model.get(AppMenuItemProperties.CLICK_HANDLER);
+        ModelList subList = model.get(AppMenuItemProperties.ADDITIONAL_ICONS);
+        View titleContainer = view.findViewById(R.id.menu_item_container);
+        AppMenuItemIcon checkbox = view.findViewById(R.id.checkbox);
+        if (clickHandler == null
+                || subList == null
+                || subList.size() != 1
+                || titleContainer == null
+                || checkbox == null) {
+            return;
         }
+        PropertyModel checkboxModel = subList.get(0).model;
+        View.OnClickListener toggle =
+                v -> {
+                    boolean checked = !checkboxModel.get(AppMenuItemProperties.CHECKED);
+                    checkboxModel.set(AppMenuItemProperties.CHECKED, checked);
+                    checkbox.setChecked(checked);
+                    clickHandler.onItemClick(checkboxModel);
+                };
+        titleContainer.setOnTouchListener(null);
+        titleContainer.setOnClickListener(toggle);
+        checkbox.setOnClickListener(toggle);
     }
 
