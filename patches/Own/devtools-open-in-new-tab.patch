+    private ListItem buildDevToolsNewTabItem() {
+        boolean isChecked =
+                UserPrefs.get(getProfileFromTabModel().getOriginalProfile())
+                        .getBoolean(DEVTOOLS_OPEN_IN_NEW_TAB_PREF);
+        PropertyModel model =
+                AppMenuItemUtils.buildModelForMenuItemWithCheckbox(
+                        mContext,
+                        getAppMenuItemTheme(),
+                        R.id.dev_tools_new_tab_id,
+                        R.string.menu_dev_tools_new_tab,
+                        0,
+                        R.id.dev_tools_new_tab_check_id,
+                        isChecked,
+                        isMenuIconAtStart());
+        model.set(AppMenuItemProperties.KEEP_MENU_OPEN, true);
+        model.get(AppMenuItemProperties.ADDITIONAL_ICONS)
+                .get(0)
+                .model
+                .set(AppMenuItemProperties.KEEP_MENU_OPEN, true);
+        return new ListItem(AppMenuHandler.AppMenuItemType.TITLE_BUTTON, model);
+    }
