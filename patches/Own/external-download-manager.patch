subject: Add external download manager support

Offer each download to another app (ADM, 1DM) instead of fetching it in the browser,
behind a switch in Settings > Downloads. Nothing is offered while the switch is off.
---
diff --git a/chrome/browser/download/android/download_controller.cc b/chrome/browser/download/android/download_controller.cc
--- a/chrome/browser/download/android/download_controller.cc
+++ b/chrome/browser/download/android/download_controller.cc
@@ -369,6 +369,19 @@
 }
 
 void DownloadController::OnDownloadStarted(DownloadItem* download_item) {
+  {
+    JNIEnv* env = base::android::AttachCurrentThread();
+    if (Java_DownloadController_maybeOpenWithExternalApp(
+            env, url::GURLAndroid::FromNativeGURL(env, download_item->GetURL()),
+            download_item->GetMimeType(),
+            url::GURLAndroid::FromNativeGURL(
+                env, download_item->GetReferrerUrl()))) {
+      ScheduleRemoveDownloadItem(download_item);
+      download_item->RemoveObserver(this);
+      return;
+    }
+  }
+
   // For dangerous downloads, we need to show the dangerous infobar before the
   // download can start.
   if (!download_item->IsDangerous() &&
