+        private void maybeApplyDesktopSiteSetting(NavigationHandle navigation) {
+            GURL reissued = mUserAgentReissuedUrl;
+            mUserAgentReissuedUrl = null;
+            WebContents webContents = mTab.getWebContents();
+            if (navigation.isSameDocument() || navigation.isPost() || webContents == null) {
+                return;
+            }
+            GURL url = navigation.getUrl();
+            String scheme = url.getScheme();
+            if (!"http".equals(scheme) && !"https".equals(scheme)) return;
+            @UserAgentOverrideOption
+            int option = mTab.calculateUserAgentOverrideOption(url);
+            if (option == UserAgentOverrideOption.INHERIT || url.equals(reissued)) return;
+            mUserAgentReissuedUrl = url;
+            webContents
+                    .getNavigationController()
+                    .setUseDesktopUserAgent(
+                            option == UserAgentOverrideOption.TRUE,
+                            /* reloadOnChange= */ false,
+                            /* skipOnInitialNavigation= */ false);
+            PostTask.postTask(
+                    TaskTraits.UI_DEFAULT,
+                    () -> {
+                        if (!mTab.isDestroyed()) mTab.loadUrl(new LoadUrlParams(url.getSpec()));
+                    });
+        }
