subject: Fix native account consistency for microG

Match accounts by email as well as Gaia ID when reconciling, and treat the cookie jar
as empty on kEnableReconcile so microG accounts get a Multilogin.
---
diff --git a/components/signin/core/browser/account_reconcilor.cc b/components/signin/core/browser/account_reconcilor.cc
--- a/components/signin/core/browser/account_reconcilor.cc
+++ b/components/signin/core/browser/account_reconcilor.cc
@@ -430,7 +430,8 @@
 
   // In the case of a forced reconciliation, we will not rely on ListAccounts,
   // and consider the cookie jar to be empty.
-  if (trigger_ == Trigger::kForcedReconcile) {
+  if (trigger_ == Trigger::kForcedReconcile ||
+      trigger_ == Trigger::kEnableReconcile) {
     OnAccountsInCookieUpdated(
         /*accounts_in_cookie_jar_info=*/signin::AccountsInCookieJarInfo(
             /*accounts_are_fresh=*/true,
diff --git a/components/signin/internal/identity_manager/account_tracker_service.cc b/components/signin/internal/identity_manager/account_tracker_service.cc
--- a/components/signin/internal/identity_manager/account_tracker_service.cc
+++ b/components/signin/internal/identity_manager/account_tracker_service.cc
@@ -316,11 +316,18 @@
 
   // Whether the existing account in pref matches the fetched account.
   bool accounts_matching =
-      user_info_copy.GetAccountId() == account_info.GetAccountId();
+      user_info_copy.GetAccountId() == account_info.GetAccountId() ||
+      (user_info_copy.GetEmail() == account_info.GetEmail() &&
+       !account_info.GetEmail().empty());
   base::UmaHistogramBoolean("Signin.AccountInPref.MatchingFetchedAccount",
                             accounts_matching);
 
   if (accounts_matching) {
+    if (user_info_copy.GetAccountId() != account_info.GetAccountId()) {
+      user_info_copy = AccountInfo::Builder(user_info_copy)
+                           .SetAccountId(account_info.GetAccountId())
+                           .Build();
+    }
     account_info.UpdateWith(user_info_copy);
   } else {
     DLOG(ERROR) << "Cannot set account info from user info as account ids "
