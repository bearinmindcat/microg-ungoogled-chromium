+++ b/components/signin/internal/identity_manager/account_tracker_service.cc
@@ -291,11 +291,19 @@ void AccountTrackerService::SetAccountInfoFromUserInfo(
       PickAccountIdForAccount(fetched_user_info.gaia, fetched_user_info.email);
 
   // Whether the existing account in pref matches the fetched account.
-  bool accounts_matching = user_info_copy.account_id == account_info.account_id;
+  // MICROG FIX: Also match by email since microG may provide different account ID format
+  bool accounts_matching =
+      user_info_copy.account_id == account_info.account_id ||
+      (user_info_copy.email == account_info.email && !account_info.email.empty());
   base::UmaHistogramBoolean("Signin.AccountInPref.MatchingFetchedAccount",
                             accounts_matching);
 
   if (accounts_matching) {
+    // MICROG FIX: If account IDs differ but emails match, update user_info_copy
+    // to use existing ID so UpdateWith() doesn't reject the update
+    if (user_info_copy.account_id != account_info.account_id) {
+      user_info_copy.account_id = account_info.account_id;
+    }
     account_info.UpdateWith(user_info_copy);
   } else {
     DLOG(ERROR) << "Cannot set account info from user info as account ids "
diff --git a/components/signin/internal/identity_manager/gaia_cookie_manager_service.cc b/components/signin/internal/identity_manager/gaia_cookie_manager_service.cc
