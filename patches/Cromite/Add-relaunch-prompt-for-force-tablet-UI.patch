+    public void requestRestart(@Nullable Activity activity) {
+        if (!(activity instanceof SnackbarManageable)) return;
+        SnackbarManager manager = ((SnackbarManageable) activity).getSnackbarManager();
+        if (manager.isShowing()) return;
+        Snackbar snackbar =
+                Snackbar.make(
+                                activity.getString(R.string.ui_relaunch_notice),
+                                new SnackbarManager.SnackbarController() {
+                                    @Override
+                                    public void onAction(@Nullable Object actionData) {
+                                        ApplicationLifetime.terminate(true);
+                                    }
+                                },
+                                Snackbar.TYPE_NOTIFICATION,
+                                Snackbar.UMA_UNKNOWN)
+                        .setAction(activity.getString(R.string.relaunch), null)
+                        .setDuration(70000);
+        manager.showSnackbar(snackbar);
+    }
